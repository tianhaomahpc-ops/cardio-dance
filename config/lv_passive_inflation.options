# LV passive inflation verification case, Land et al. (2015) RSPA Problem 3.
# Pure passive Holzapfel-Ogden response under a static endocardial pressure
# dead-load. EP is off (no stimulus, no Purkinje); mechanics is the only
# physics. With Tref=0 and stim_amp=0 there is no active component, so the
# resulting deformation is a clean test of the H-O implementation + the new
# endo pressure boundary integrator + the base clamp / epi Robin spring.

mesh_path=benchmarks/lv_ellipsoid/lv_ellipsoid.mesh

use_fiber_gf=1
fiber_f_path=benchmarks/lv_ellipsoid/fiber_f.gf
fiber_s_path=benchmarks/lv_ellipsoid/fiber_s.gf
fiber_n_path=benchmarks/lv_ellipsoid/fiber_n.gf

# EP knobs need values but are inert (no stim, very short run).
cm_uF_per_mm2=0.01
chi_per_mm=140.0
sigma_f_mS_per_mm=0.1334
sigma_s_mS_per_mm=0.0176
sigma_n_mS_per_mm=0.0176

dt_pde_ms=0.05
dt_ode_ms=0.05
t_end_ms=5.0   # one mechanics step at mech_substep=50 (= 2.5 ms each)

stim_start_ms=0.0
stim_end_ms=-1.0
stim_amp=0.0
stim_xmin_mm=0.0
stim_xmax_mm=-1.0
stim_ymin_mm=0.0
stim_ymax_mm=-1.0
stim_zmin_mm=0.0
stim_zmax_mm=-1.0
stim_fraction=0.0

enable_purkinje=0

use_petsc=1
ksp_max_it=500
ksp_rtol=1e-8

# ---------- Mechanics only ----------
mechanics_enable=1
mech_substep=50

# Land 2015 RSPA Problem 3 H-O constants (kPa).
mech_ho_a=0.059
mech_ho_b=8.023
mech_ho_af=18.472
mech_ho_bf=16.026
mech_ho_as=2.481
mech_ho_bs=11.120
mech_ho_afs=0.216
mech_ho_bfs=11.436
mech_ho_kappa=1000.0   # nearly-incompressible (Land 2015 uses Lagrange mult.;
                       # we use volumetric penalty -- 1000 kPa is tight enough
                       # that J stays within a few % of 1)

mech_bdr_base_attr=1
mech_bdr_endo_attr=2
mech_bdr_epi_attr=3

# Endocardial pressure dead-load. Land 2015 ramps 0 -> 10 kPa; start with a
# moderate value to verify the integrator before sweeping.
mech_endo_pressure_pa=2000.0   # 2 kPa
mech_peri_spring_k_kpa_per_mm=0.0   # no pericardium for passive verification

# No active.
land_Tref_kPa=0.0
land_Ca50_uM=0.805

mech_snes_max_it=40
mech_snes_rtol=1e-6
mech_snes_atol=1e-9
mech_snes_print_level=1   # show Newton residual history
mech_ksp_max_it=500
mech_ksp_rtol=1e-6
mech_asm_overlap=1

output_stride=10
checkpoint_stride=0
output_dir=output/lv_passive_inflation
checkpoint_dir=checkpoint/lv_passive_inflation
