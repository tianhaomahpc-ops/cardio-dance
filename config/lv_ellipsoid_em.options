# Idealized prolate-ellipsoidal LV electromechanical benchmark.
# Geometry: Land et al. (2015) cardiac-mechanics verification ellipsoid.
# Generated by:
#   ./build/generate_lv_ellipsoid_case --out-dir benchmarks/lv_ellipsoid
# Run with:
#   mpirun -np 1 ./build/monodomain --config config/lv_ellipsoid_em.options

mesh_path=benchmarks/lv_ellipsoid/lv_ellipsoid.mesh

use_fiber_gf=1
fiber_f_path=benchmarks/lv_ellipsoid/fiber_f.gf
fiber_s_path=benchmarks/lv_ellipsoid/fiber_s.gf
fiber_n_path=benchmarks/lv_ellipsoid/fiber_n.gf

# EP material (mS/mm, uF/mm^2, mm^-1) -- Niederer-style cardiac defaults.
cm_uF_per_mm2=0.01
chi_per_mm=140.0
sigma_f_mS_per_mm=0.1334
sigma_s_mS_per_mm=0.0176
sigma_n_mS_per_mm=0.0176

# Time -- short demo; bumps for production should use t_end_ms ~ 800 ms.
dt_pde_ms=0.02
dt_ode_ms=0.01
t_end_ms=50.0

# Apex-region stimulus (z near -r_long, x~y~0).
stim_start_ms=0.0
stim_end_ms=2.0
stim_amp=-15.0
stim_region=ball,0.0,0.0,-18.0,2.5

# Solver
use_petsc=1
ksp_max_it=500
ksp_rtol=1e-8

# ---------- Electromechanical coupling ----------
mechanics_enable=1
mech_substep=50   # 50 * 0.02ms = 1 ms between mech solves

# Holzapfel-Ogden (2009 Table 1, transversely isotropic LV)
mech_ho_a=0.059
mech_ho_b=8.023
mech_ho_af=18.472
mech_ho_bf=16.026
mech_ho_as=2.481
mech_ho_bs=11.120
mech_ho_afs=0.216
mech_ho_bfs=11.436
mech_ho_kappa=1000.0

# Boundary attributes set by generate_lv_ellipsoid_case:
#   1 = base ring (clamped), 2 = endo, 3 = epi
mech_bdr_base_attr=1
mech_bdr_endo_attr=2
mech_bdr_epi_attr=3
mech_endo_pressure_pa=0.0
mech_peri_spring_k_kpa_per_mm=0.0

# Land 2017 active-tension defaults.
land_Tref_kPa=120.0
land_Ca50_uM=0.805

mech_snes_max_it=30
mech_snes_rtol=1e-6
mech_snes_atol=1e-10
mech_snes_print_level=0
mech_ksp_max_it=500
mech_ksp_rtol=1e-6
mech_asm_overlap=1

# Output
output_stride=25
checkpoint_stride=500
output_dir=output/lv_ellipsoid_em
checkpoint_dir=checkpoint/lv_ellipsoid_em
