# Half-ellipsoid hollow ventricle + Purkinje + 1-lead pseudo-ECG demo.
# Generate the mesh once with:
#   ./build/generate_half_ellipsoid_case --h-mm 1.5 --emit-fibers
# (writes benchmarks/half_ellipsoid/heart.mesh + fiber_*.gf)

mesh_path=benchmarks/half_ellipsoid/heart.mesh
use_fiber_gf=1
fiber_f_path=benchmarks/half_ellipsoid/fiber_f.gf
fiber_s_path=benchmarks/half_ellipsoid/fiber_s.gf
fiber_n_path=benchmarks/half_ellipsoid/fiber_n.gf

# Material (TT06 ventricle defaults)
cm_uF_per_mm2=0.01
chi_per_mm=140.0
sigma_f_mS_per_mm=0.1334
sigma_s_mS_per_mm=0.0176
sigma_n_mS_per_mm=0.0176

# Time -- 100 ms enough to capture activation propagation across the wall
# under 91-terminal Purkinje + smeared PVJ.
dt_pde_ms=0.05
dt_ode_ms=0.05
t_end_ms=100.0

# No direct myocardial stim; activation comes from Purkinje only.
stim_start_ms=0.0
stim_end_ms=-1.0
stim_amp=0.0
stim_xmin_mm=0.0
stim_xmax_mm=-1.0
stim_ymin_mm=0.0
stim_ymax_mm=-1.0
stim_zmin_mm=0.0
stim_zmax_mm=-1.0
stim_fraction=0.0

# Purkinje network: tree generated by tools/generate_purkinje_tree.py
# rooted near apex (x=33), bbox matching the inner cavity.
enable_purkinje=1
purkinje_network_path=config/half_ellipsoid_purkinje.network
purkinje_cable_subdivision=1
purkinje_dt_ms=0.005
purkinje_cm_uF_per_mm2=0.01
purkinje_edge_g_mS_per_mm=0.05
purkinje_v_rest_mv=-90.0

# Cluster pace at the apex (root + first 2 children) -- single-node stim
# is drained by 1D diffusion before I_Na can fire.
purkinje_stim_nodes=0,1,2
purkinje_stim_start_ms=0.0
purkinje_stim_end_ms=1.0
purkinje_stim_amp_uA_per_uF=-150.0

# PVJ coupling: terminals get mapped to nearest endocardial DOF (within 5 mm).
# PVJ coupling strong enough to fire myocardium past Na threshold despite
# local diffusion. Tuned empirically; physiological values are uncertain.
pvj_g_mS=5.0
pvj_max_dist_mm=5.0
pvj_current_scale=4.0
pvj_delay_ms=0.0
# Smear each PVJ injection over a 4 mm ball of local DOFs so the initial
# activation patch is large enough to overcome 3D source-sink mismatch
# and self-sustain a propagating wave.
pvj_smear_radius_mm=4.0

# 1-lead pseudo-ECG: probe sits 80 mm in front of heart center along +y.
enable_pseudo_ecg=1
pseudo_ecg_probe=lead_lateral,17.5,80,0
pseudo_ecg_sigma_i_mS_per_mm=0.174
pseudo_ecg_sigma_b_mS_per_mm=0.2
pseudo_ecg_stride=10

# Solver -- enable BoomerAMG since the fine mesh has ~150k DOFs.
use_petsc=0
use_hypre_boomeramg=1
ksp_max_it=500
ksp_rtol=1e-8

# Output -- dense for movie rendering: 1 frame per 1 ms.
output_stride=20
checkpoint_stride=0
output_dir=output/half_ellipsoid_purkinje
checkpoint_dir=checkpoint/half_ellipsoid_purkinje
