# LV electromechanical demo with multi-point endocardial stimulation.
# Approximates the result of a Purkinje system firing 7 PVJs around the LV
# endocardial surface (apex + mid + base on anterior, septal, lateral walls)
# at t = 0. From these seeds the myocardial AP wave propagates across the
# entire ventricle in ~30-40 ms, similar to a physiological LBB-paced LV.
#
# Mesh: regen with h ~ 1 mm before running this config:
#   mpirun -np 1 ./build/generate_lv_ellipsoid_case \
#     --out-dir benchmarks/lv_ellipsoid \
#     --n-phi 50 --n-mu 24 --n-wall 4 --apex-hole-deg 15

mesh_path=benchmarks/lv_ellipsoid/lv_ellipsoid.mesh

use_fiber_gf=1
fiber_f_path=benchmarks/lv_ellipsoid/fiber_f.gf
fiber_s_path=benchmarks/lv_ellipsoid/fiber_s.gf
fiber_n_path=benchmarks/lv_ellipsoid/fiber_n.gf

# EP material (Niederer slab anisotropy applied uniformly).
cm_uF_per_mm2=0.01
chi_per_mm=140.0
sigma_f_mS_per_mm=0.1334
sigma_s_mS_per_mm=0.0176
sigma_n_mS_per_mm=0.0176

dt_pde_ms=0.05
dt_ode_ms=0.05
t_end_ms=150.0

# 7 endocardial stim balls mimicking PVJ firing at the endocardial surface
# (apex + 3 mid-wall + 3 near-base). Endo radius at mid-wall is ~5 mm so the
# balls sit just inside the LV wall to fire the nearest myocardial cells.
stim_start_ms=0.0
stim_end_ms=2.0
stim_amp=-30.0
stim_region=ball,3.5,0.0,-12.0,1.5
stim_region=ball,-1.75,3.03,-12.0,1.5
stim_region=ball,-1.75,-3.03,-12.0,1.5
stim_region=ball,4.7,0.0,-5.0,1.5
stim_region=ball,-2.35,4.07,-5.0,1.5
stim_region=ball,-2.35,-4.07,-5.0,1.5
stim_region=ball,5.5,0.0,2.0,1.5
# Legacy single-box keys (disabled; multi-region path active above).
stim_xmin_mm=0.0
stim_xmax_mm=-1.0
stim_ymin_mm=0.0
stim_ymax_mm=-1.0
stim_zmin_mm=0.0
stim_zmax_mm=-1.0
stim_fraction=0.0

# Purkinje disabled -- the existing PurkinjeSystem is a passive linear cable
# that gets clamped to myocardial Vm by PVJ drain at every terminal, so the
# wave can't propagate along the tree. The Stewart Purkinje + smear PVJ on
# branch claude/review-branch-history-9W03K would fix that; integrating it
# is a follow-up. For now we emulate the PVJ firing pattern with direct
# endo stimuli.
enable_purkinje=0

# Solver
use_petsc=1
use_hypre_boomeramg=0
ksp_max_it=500
ksp_rtol=1e-8

# ---------- Electromechanical coupling ----------
mechanics_enable=1
mech_substep=50   # every 2.5 ms

mech_ho_a=0.059
mech_ho_b=8.023
mech_ho_af=18.472
mech_ho_bf=16.026
mech_ho_as=2.481
mech_ho_bs=11.120
mech_ho_afs=0.216
mech_ho_bfs=11.436
mech_ho_kappa=10000.0

mech_bdr_base_attr=1
mech_bdr_endo_attr=2
mech_bdr_epi_attr=3
mech_endo_pressure_pa=0.0
mech_peri_spring_k_kpa_per_mm=2.0

land_Tref_kPa=60.0
land_Ca50_uM=0.805

mech_snes_max_it=30
mech_snes_rtol=1e-5
mech_snes_atol=1e-8
mech_snes_print_level=0
mech_ksp_max_it=500
mech_ksp_rtol=1e-5
mech_asm_overlap=1

output_stride=50   # frame every 2.5 ms -> 60 frames
checkpoint_stride=0
output_dir=output/lv_ellipsoid_em_endo
checkpoint_dir=checkpoint/lv_ellipsoid_em_endo
