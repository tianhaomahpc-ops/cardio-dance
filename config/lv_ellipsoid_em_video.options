# Long-run LV electromechanical demo: TT06 monodomain + Land2017 + H-O.
# Output is streamed to ParaView at 5 ms cadence -> ~60 frames per heartbeat,
# enough for an MP4 of the contracting LV.

mesh_path=benchmarks/lv_ellipsoid/lv_ellipsoid.mesh

use_fiber_gf=1
fiber_f_path=benchmarks/lv_ellipsoid/fiber_f.gf
fiber_s_path=benchmarks/lv_ellipsoid/fiber_s.gf
fiber_n_path=benchmarks/lv_ellipsoid/fiber_n.gf

# EP material (Niederer slab anisotropy applied uniformly).
cm_uF_per_mm2=0.01
chi_per_mm=140.0
sigma_f_mS_per_mm=0.1334
sigma_s_mS_per_mm=0.0176
sigma_n_mS_per_mm=0.0176

dt_pde_ms=0.05
dt_ode_ms=0.05
t_end_ms=400.0

# Apex stimulus 0..2 ms.
stim_start_ms=0.0
stim_end_ms=2.0
stim_amp=-15.0
stim_region=ball,0.0,0.0,-18.0,5.0

# Solver: MFEM CG + Hypre BoomerAMG for EP; MFEM Newton + HypreGMRES for
# mechanics (MFEM's PetscNonlinearSolver wrapper exits after iter 0 silently
# on this problem; needs further investigation).
use_petsc=1
use_hypre_boomeramg=0
ksp_max_it=500
ksp_rtol=1e-8

# ---------- Electromechanical coupling ----------
mechanics_enable=1
mech_substep=50   # 50 * 0.05ms = 2.5 ms between mechanics solves

# Holzapfel-Ogden 2009 (isochoric ground, full-F anisotropic).
mech_ho_a=0.059
mech_ho_b=8.023
mech_ho_af=18.472
mech_ho_bf=16.026
mech_ho_as=2.481
mech_ho_bs=11.120
mech_ho_afs=0.216
mech_ho_bfs=11.436
mech_ho_kappa=1000.0

# Boundary attrs from generate_lv_ellipsoid_case:
#   1 = base ring (clamped), 2 = endo, 3 = epi
mech_bdr_base_attr=1
mech_bdr_endo_attr=2
mech_bdr_epi_attr=3
mech_endo_pressure_pa=0.0
mech_peri_spring_k_kpa_per_mm=0.5

# Land 2017 active-tension defaults (human).
land_Tref_kPa=120.0
land_Ca50_uM=0.805

mech_snes_max_it=30
mech_snes_rtol=1e-5
mech_snes_atol=1e-8
mech_snes_print_level=0
mech_ksp_max_it=500
mech_ksp_rtol=1e-5
mech_asm_overlap=1

# Save a ParaView frame every 5 ms; 300 ms -> 60 frames.
output_stride=100
checkpoint_stride=0
output_dir=output/lv_ellipsoid_em_video
checkpoint_dir=checkpoint/lv_ellipsoid_em_video
